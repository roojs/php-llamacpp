export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export PHP_RPATH = no

# libllama.pc lives outside the default pkg-config search path.
export PKG_CONFIG_PATH := /usr/lib/x86_64-linux-gnu/llama/pkgconfig:$(PKG_CONFIG_PATH)

# One .so per PHP version reported by the distro. dh-php then enables
# the module for every SAPI of that version.
PHP_VERSIONS := $(shell phpquery -V 2>/dev/null)
ifeq ($(strip $(PHP_VERSIONS)),)
$(error phpquery -V returned no PHP versions; install php-all-dev)
endif

%:
	dh $@ --with php

# The extension is phpize'd inside build-<version>/. Do not autoreconf
# or distclean a developer phpize tree left in the repository root.
override_dh_autoreconf:
	true

override_dh_autoreconf_clean:
	true

override_dh_update_autotools_config:
	true

override_dh_auto_configure:
	set -eu; \
	for v in $(PHP_VERSIONS); do \
		rm -rf "build-$$v"; \
		mkdir "build-$$v"; \
		cp config.m4 php_llamacpp.c php_llamacpp.h "build-$$v/"; \
		( cd "build-$$v" && phpize$$v && ./configure --with-php-config="/usr/bin/php-config$$v" ); \
	done

override_dh_auto_build:
	set -eu; \
	for v in $(PHP_VERSIONS); do \
		$(MAKE) -C "build-$$v"; \
	done

override_dh_auto_test:
	true

override_dh_auto_install:
	true

override_dh_php:
	set -eu; \
	for v in $(PHP_VERSIONS); do \
		pkg="php$${v}-llamacpp"; \
		grep -qx "Package: $$pkg" debian/control || { \
			echo "debian/control has no $$pkg; run scripts/release/set-debian-php-package.sh" >&2; \
			exit 1; \
		}; \
		printf 'mod build-%s/modules/llamacpp.so\nmod debian/llamacpp.ini\n' "$$v" > "debian/$$pkg.php"; \
		dh_php -p "$$pkg" --php-version="$$v"; \
	done

override_dh_shlibdeps:
	dh_shlibdeps -- -l/usr/lib/x86_64-linux-gnu/llama

override_dh_auto_clean:
	rm -rf build-*
	rm -f debian/php[0-9]*-llamacpp.php

override_dh_clean:
	rm -rf build-*
	rm -f debian/php[0-9]*-llamacpp.php
	dh_clean
